type Query {
  people(query: UsersListInput!): UsersPage
  orderItems(query: OrderItemsListInput!): OrderItemsPage!
  health: Health!
}

type Mutation {
  exportPeople(input: UsersExportInput!): ExportJob!
}

# Health is an application type, to show the model generator still runs.
type Health {
  ok: Boolean!
}
