type OrderItemsRow {
  id: Int64!
  sku: String!
  quantity: Int64!
}

type OrderItemsPage {
  items: [OrderItemsRow!]!
  totalCount: Int!
}

enum OrderItemsSortField {
  ID
  SKU
  QUANTITY
}

input OrderItemsSort {
  field: OrderItemsSortField!
  direction: SortDirection! = ASC
}

input OrderItemsListInput {
  filter: String
  sort: [OrderItemsSort!]
  limit: Int
  offset: Int
  """
  The client's UTC offset in minutes, positive east of UTC (UTC+02:00 is 120),
  between -720 and 840. Relative time values such as TODAY are evaluated in
  this zone. When omitted, the server's local time zone is used.
  """
  timezone: Int
}

enum OrderItemsExportField {
  ID
  SKU
  QUANTITY
}

input OrderItemsExportInput {
  fields: [OrderItemsExportField!]!
  filter: String
  sort: [OrderItemsSort!]
  format: ExportFormat!
  """
  The client's UTC offset in minutes, positive east of UTC (UTC+02:00 is 120),
  between -720 and 840. Relative time values such as TODAY are evaluated in
  this zone. When omitted, the server's local time zone is used.
  """
  timezone: Int
  """
  The moment at which relative time values such as TODAY are evaluated. When
  omitted, the server's current time is used.
  """
  asOf: Time
}
