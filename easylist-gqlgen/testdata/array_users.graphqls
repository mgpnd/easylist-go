type UsersRow {
  id: Int64!
  tags: [String!]!
  statuses: [UsersStatuses!]
  group_ids: [UUID!]!
  labels: [String!]!
}

type UsersPage {
  items: [UsersRow!]!
  totalCount: Int!
}

enum UsersStatuses {
  OK
  FAILED
}

enum UsersSortField {
  ID
}

input UsersSort {
  field: UsersSortField!
  direction: SortDirection! = ASC
}

input UsersListInput {
  filter: String
  sort: [UsersSort!]
  limit: Int
  offset: Int
  """
  The client's UTC offset in minutes, positive east of UTC (UTC+02:00 is 120),
  between -720 and 840. Relative time values such as TODAY are evaluated in
  this zone. When omitted, the server's local time zone is used.
  """
  timezone: Int
}

enum UsersExportField {
  ID
  TAGS
  STATUSES
  GROUP_IDS
  LABELS
}

input UsersExportInput {
  fields: [UsersExportField!]!
  filter: String
  sort: [UsersSort!]
  format: ExportFormat!
  """
  The client's UTC offset in minutes, positive east of UTC (UTC+02:00 is 120),
  between -720 and 840. Relative time values such as TODAY are evaluated in
  this zone. When omitted, the server's local time zone is used.
  """
  timezone: Int
  """
  The moment at which relative time values such as TODAY are evaluated. When
  omitted, the server's current time is used.
  """
  asOf: Time
}
