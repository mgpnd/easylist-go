# TODAY on a date field
due = TODAY
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."due" AS "due" FROM people AS p WHERE (p.deleted_at IS NULL) AND p."due" = $1 ORDER BY p."id" ASC LIMIT $2 OFFSET $3
  args: [time(2026-10-27T00:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND p."due" = $1
  args: [time(2026-10-27T00:00:00Z)]

# The current week, Monday to Sunday
due >= START_OF_WEEK AND due <= END_OF_WEEK
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."due" AS "due" FROM people AS p WHERE (p.deleted_at IS NULL) AND (p."due" >= $1 AND p."due" <= $2) ORDER BY p."id" ASC LIMIT $3 OFFSET $4
  args: [time(2026-10-26T00:00:00Z), time(2026-11-01T00:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND (p."due" >= $1 AND p."due" <= $2)
  args: [time(2026-10-26T00:00:00Z), time(2026-11-01T00:00:00Z)]

# The current month
due >= START_OF_MONTH AND due <= END_OF_MONTH
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."due" AS "due" FROM people AS p WHERE (p.deleted_at IS NULL) AND (p."due" >= $1 AND p."due" <= $2) ORDER BY p."id" ASC LIMIT $3 OFFSET $4
  args: [time(2026-10-01T00:00:00Z), time(2026-10-31T00:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND (p."due" >= $1 AND p."due" <= $2)
  args: [time(2026-10-01T00:00:00Z), time(2026-10-31T00:00:00Z)]

# The current year
due >= START_OF_YEAR AND due <= END_OF_YEAR
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."due" AS "due" FROM people AS p WHERE (p.deleted_at IS NULL) AND (p."due" >= $1 AND p."due" <= $2) ORDER BY p."id" ASC LIMIT $3 OFFSET $4
  args: [time(2026-01-01T00:00:00Z), time(2026-12-31T00:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND (p."due" >= $1 AND p."due" <= $2)
  args: [time(2026-01-01T00:00:00Z), time(2026-12-31T00:00:00Z)]

# Business days skip the weekend: Tuesday + 3 is Friday
due = {TODAY + 3::BUSINESS_DAYS}
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."due" AS "due" FROM people AS p WHERE (p.deleted_at IS NULL) AND p."due" = $1 ORDER BY p."id" ASC LIMIT $2 OFFSET $3
  args: [time(2026-10-30T00:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND p."due" = $1
  args: [time(2026-10-30T00:00:00Z)]

# ... and Tuesday + 5 is the next Tuesday
due = {TODAY + 5::BUSINESS_DAYS}
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."due" AS "due" FROM people AS p WHERE (p.deleted_at IS NULL) AND p."due" = $1 ORDER BY p."id" ASC LIMIT $2 OFFSET $3
  args: [time(2026-11-03T00:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND p."due" = $1
  args: [time(2026-11-03T00:00:00Z)]

# NOW minus minutes on a timestamp field
last_seen > {NOW - 30::MINUTES}
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."last_seen" AS "last_seen" FROM people AS p WHERE (p.deleted_at IS NULL) AND p."last_seen" > $1 ORDER BY p."id" ASC LIMIT $2 OFFSET $3
  args: [time(2026-10-27T09:30:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND p."last_seen" > $1
  args: [time(2026-10-27T09:30:00Z)]

# NOW minus hours
last_seen > {NOW - 2::HOURS}
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."last_seen" AS "last_seen" FROM people AS p WHERE (p.deleted_at IS NULL) AND p."last_seen" > $1 ORDER BY p."id" ASC LIMIT $2 OFFSET $3
  args: [time(2026-10-27T08:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND p."last_seen" > $1
  args: [time(2026-10-27T08:00:00Z)]

# TODAY on a timestamp field is the whole day
last_seen = TODAY
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."last_seen" AS "last_seen" FROM people AS p WHERE (p.deleted_at IS NULL) AND (p."last_seen" >= $1 AND p."last_seen" < $2) ORDER BY p."id" ASC LIMIT $3 OFFSET $4
  args: [time(2026-10-27T00:00:00Z), time(2026-10-28T00:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND (p."last_seen" >= $1 AND p."last_seen" < $2)
  args: [time(2026-10-27T00:00:00Z), time(2026-10-28T00:00:00Z)]

# != TODAY on a timestamp field keeps NULL rows
last_seen != TODAY
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."last_seen" AS "last_seen" FROM people AS p WHERE (p.deleted_at IS NULL) AND COALESCE(NOT (p."last_seen" >= $1 AND p."last_seen" < $2), TRUE) ORDER BY p."id" ASC LIMIT $3 OFFSET $4
  args: [time(2026-10-27T00:00:00Z), time(2026-10-28T00:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND COALESCE(NOT (p."last_seen" >= $1 AND p."last_seen" < $2), TRUE)
  args: [time(2026-10-27T00:00:00Z), time(2026-10-28T00:00:00Z)]

# >= a date on a timestamp field starts at midnight
last_seen >= START_OF_WEEK
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."last_seen" AS "last_seen" FROM people AS p WHERE (p.deleted_at IS NULL) AND p."last_seen" >= $1 ORDER BY p."id" ASC LIMIT $2 OFFSET $3
  args: [time(2026-10-26T00:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND p."last_seen" >= $1
  args: [time(2026-10-26T00:00:00Z)]

# <= a date on a timestamp field includes that whole day: Eve at 23:59:59
last_seen <= {TODAY - 1::DAYS}
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."last_seen" AS "last_seen" FROM people AS p WHERE (p.deleted_at IS NULL) AND p."last_seen" < $1 ORDER BY p."id" ASC LIMIT $2 OFFSET $3
  args: [time(2026-10-27T00:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND p."last_seen" < $1
  args: [time(2026-10-27T00:00:00Z)]

# The current month on a timestamp field
last_seen >= START_OF_MONTH AND last_seen <= END_OF_MONTH
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."last_seen" AS "last_seen" FROM people AS p WHERE (p.deleted_at IS NULL) AND (p."last_seen" >= $1 AND p."last_seen" < $2) ORDER BY p."id" ASC LIMIT $3 OFFSET $4
  args: [time(2026-10-01T00:00:00Z), time(2026-11-01T00:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND (p."last_seen" >= $1 AND p."last_seen" < $2)
  args: [time(2026-10-01T00:00:00Z), time(2026-11-01T00:00:00Z)]

# < START_OF_YEAR on a timestamp field
last_seen < START_OF_YEAR
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."last_seen" AS "last_seen" FROM people AS p WHERE (p.deleted_at IS NULL) AND p."last_seen" < $1 ORDER BY p."id" ASC LIMIT $2 OFFSET $3
  args: [time(2026-01-01T00:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND p."last_seen" < $1
  args: [time(2026-01-01T00:00:00Z)]

# DAYS on a timestamp field
created_at >= {TODAY - 7::DAYS}
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."created_at" AS "created_at" FROM people AS p WHERE (p.deleted_at IS NULL) AND p."created_at" >= $1 ORDER BY p."id" ASC LIMIT $2 OFFSET $3
  args: [time(2026-10-20T00:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND p."created_at" >= $1
  args: [time(2026-10-20T00:00:00Z)]

# NOW minus an hour
created_at > {NOW - 1::HOURS}
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."created_at" AS "created_at" FROM people AS p WHERE (p.deleted_at IS NULL) AND p."created_at" > $1 ORDER BY p."id" ASC LIMIT $2 OFFSET $3
  args: [time(2026-10-27T09:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND p."created_at" > $1
  args: [time(2026-10-27T09:00:00Z)]

# A relative value on a lateral field
last_order_at > {NOW - 1::HOURS}
=> page
  SELECT p."id" AS "id", p."name" AS "name", ord.last_order_at AS "last_order_at" FROM people AS p LEFT JOIN LATERAL (
  			SELECT count(*) AS order_count, max(o.placed_at) AS last_order_at FROM orders o WHERE o.person_id = p.id
  		) ord ON TRUE WHERE (p.deleted_at IS NULL) AND (ord.last_order_at) > $1 ORDER BY p."id" ASC LIMIT $2 OFFSET $3
  args: [time(2026-10-27T09:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p LEFT JOIN LATERAL (
  			SELECT count(*) AS order_count, max(o.placed_at) AS last_order_at FROM orders o WHERE o.person_id = p.id
  		) ord ON TRUE WHERE (p.deleted_at IS NULL) AND (ord.last_order_at) > $1
  args: [time(2026-10-27T09:00:00Z)]

# Keywords are case-insensitive
due = today
=> page
  SELECT p."id" AS "id", p."name" AS "name", p."due" AS "due" FROM people AS p WHERE (p.deleted_at IS NULL) AND p."due" = $1 ORDER BY p."id" ASC LIMIT $2 OFFSET $3
  args: [time(2026-10-27T00:00:00Z), int64(10000), int64(0)]
=> count
  SELECT COUNT(*) FROM people AS p WHERE (p.deleted_at IS NULL) AND p."due" = $1
  args: [time(2026-10-27T00:00:00Z)]
