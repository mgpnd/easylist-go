# TODAY on a date field
due = TODAY
=> 1 row
  id | name    | due
   1 | Ann Lee | 2026-10-27

# The current week, Monday to Sunday
due >= START_OF_WEEK AND due <= END_OF_WEEK
=> 5 rows
  id | name       | due
   1 | Ann Lee    | 2026-10-27
   2 | Bob Stone  | 2026-10-26
   3 | Cara Diaz  | 2026-11-01
   5 | Eve Martin | 2026-10-31
   8 | Hana Sato  | 2026-10-30

# The current month
due >= START_OF_MONTH AND due <= END_OF_MONTH
=> 5 rows
  id | name        | due
   1 | Ann Lee     | 2026-10-27
   2 | Bob Stone   | 2026-10-26
   4 | Dan O'Brien | 2026-10-01
   5 | Eve Martin  | 2026-10-31
   8 | Hana Sato   | 2026-10-30

# The current year
due >= START_OF_YEAR AND due <= END_OF_YEAR
=> 10 rows
  id | name        | due
   1 | Ann Lee     | 2026-10-27
   2 | Bob Stone   | 2026-10-26
   3 | Cara Diaz   | 2026-11-01
   4 | Dan O'Brien | 2026-10-01
   5 | Eve Martin  | 2026-10-31
   6 | Finn Larsen | 2026-01-01
   7 | Gil Moreau  | 2026-12-31
   8 | Hana Sato   | 2026-10-30
   9 | Ivan Petrov | 2026-11-03
  12 | Lena Novak  | 2026-11-02

# Business days skip the weekend: Tuesday + 3 is Friday
due = {TODAY + 3::BUSINESS_DAYS}
=> 1 row
  id | name      | due
   8 | Hana Sato | 2026-10-30

# ... and Tuesday + 5 is the next Tuesday
due = {TODAY + 5::BUSINESS_DAYS}
=> 1 row
  id | name        | due
   9 | Ivan Petrov | 2026-11-03

# NOW minus minutes on a timestamp field
last_seen > {NOW - 30::MINUTES}
=> 2 rows
  id | name      | last_seen
   1 | Ann Lee   | 2026-10-27T10:00:00Z
   2 | Bob Stone | 2026-10-27T09:45:00Z

# NOW minus hours
last_seen > {NOW - 2::HOURS}
=> 3 rows
  id | name      | last_seen
   1 | Ann Lee   | 2026-10-27T10:00:00Z
   2 | Bob Stone | 2026-10-27T09:45:00Z
   3 | Cara Diaz | 2026-10-27T08:30:00Z

# TODAY on a timestamp field is the whole day
last_seen = TODAY
=> 4 rows
  id | name        | last_seen
   1 | Ann Lee     | 2026-10-27T10:00:00Z
   2 | Bob Stone   | 2026-10-27T09:45:00Z
   3 | Cara Diaz   | 2026-10-27T08:30:00Z
   4 | Dan O'Brien | 2026-10-27T00:00:00Z

# != TODAY on a timestamp field keeps NULL rows
last_seen != TODAY
=> 9 rows
  id | name        | last_seen
   5 | Eve Martin  | 2026-10-26T23:59:59Z
   6 | Finn Larsen | 2026-10-26T00:00:00Z
   7 | Gil Moreau  | 2026-10-25T23:59:59Z
   8 | Hana Sato   | 2026-10-01T00:00:00Z
   9 | Ivan Petrov | 2026-09-30T23:59:59Z
  10 | Jade Wong   | 2026-01-01T00:00:00Z
  11 | Kai Becker  | 2025-12-31T23:59:59Z
  12 | Lena Novak  | NULL
  13 | Mo Reyes    | NULL

# >= a date on a timestamp field starts at midnight
last_seen >= START_OF_WEEK
=> 6 rows
  id | name        | last_seen
   1 | Ann Lee     | 2026-10-27T10:00:00Z
   2 | Bob Stone   | 2026-10-27T09:45:00Z
   3 | Cara Diaz   | 2026-10-27T08:30:00Z
   4 | Dan O'Brien | 2026-10-27T00:00:00Z
   5 | Eve Martin  | 2026-10-26T23:59:59Z
   6 | Finn Larsen | 2026-10-26T00:00:00Z

# <= a date on a timestamp field includes that whole day: Eve at 23:59:59
last_seen <= {TODAY - 1::DAYS}
=> 7 rows
  id | name        | last_seen
   5 | Eve Martin  | 2026-10-26T23:59:59Z
   6 | Finn Larsen | 2026-10-26T00:00:00Z
   7 | Gil Moreau  | 2026-10-25T23:59:59Z
   8 | Hana Sato   | 2026-10-01T00:00:00Z
   9 | Ivan Petrov | 2026-09-30T23:59:59Z
  10 | Jade Wong   | 2026-01-01T00:00:00Z
  11 | Kai Becker  | 2025-12-31T23:59:59Z

# The current month on a timestamp field
last_seen >= START_OF_MONTH AND last_seen <= END_OF_MONTH
=> 8 rows
  id | name        | last_seen
   1 | Ann Lee     | 2026-10-27T10:00:00Z
   2 | Bob Stone   | 2026-10-27T09:45:00Z
   3 | Cara Diaz   | 2026-10-27T08:30:00Z
   4 | Dan O'Brien | 2026-10-27T00:00:00Z
   5 | Eve Martin  | 2026-10-26T23:59:59Z
   6 | Finn Larsen | 2026-10-26T00:00:00Z
   7 | Gil Moreau  | 2026-10-25T23:59:59Z
   8 | Hana Sato   | 2026-10-01T00:00:00Z

# < START_OF_YEAR on a timestamp field
last_seen < START_OF_YEAR
=> 1 row
  id | name       | last_seen
  11 | Kai Becker | 2025-12-31T23:59:59Z

# DAYS on a timestamp field
created_at >= {TODAY - 7::DAYS}
=> 2 rows
  id | name       | created_at
  11 | Kai Becker | 2026-10-20T11:00:00Z
  12 | Lena Novak | 2026-10-27T09:30:00Z

# NOW minus an hour
created_at > {NOW - 1::HOURS}
=> 1 row
  id | name       | created_at
  12 | Lena Novak | 2026-10-27T09:30:00Z

# A relative value on a lateral field
last_order_at > {NOW - 1::HOURS}
=> 1 row
  id | name       | last_order_at
   5 | Eve Martin | 2026-10-27T09:50:00Z

# Keywords are case-insensitive
due = today
=> 1 row
  id | name    | due
   1 | Ann Lee | 2026-10-27
