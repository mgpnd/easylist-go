# IN on a uuid field
uid IN ('00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000013')
=> 2 rows
  id | name     | uid
   1 | Ann Lee  | 00000000-0000-4000-8000-000000000001
  13 | Mo Reyes | 00000000-0000-4000-8000-000000000013

# IN on a date field
due IN ('2026-10-27', '2026-10-30')
=> 2 rows
  id | name      | due
   1 | Ann Lee   | 2026-10-27
   8 | Hana Sato | 2026-10-30

# IN on a timestamp field compares instants
created_at IN ('2026-10-27T09:30:00Z', '2026-10-20T13:00:00+02:00')
=> 2 rows
  id | name       | created_at
  11 | Kai Becker | 2026-10-20T11:00:00Z
  12 | Lena Novak | 2026-10-27T09:30:00Z

# IN on text is exact and case-sensitive
name IN ('Ann Lee', 'bob stone')
=> 1 row
  id | name
   1 | Ann Lee

# not in, in lower case
plan not in ('free', 'pro')
=> 3 rows
  id | name        | plan
   3 | Cara Diaz   | team
   6 | Finn Larsen | team
   8 | Hana Sato   | team
