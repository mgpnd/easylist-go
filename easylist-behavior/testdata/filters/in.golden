# IN on an enum field
plan IN ('pro', 'team')
=> 7 rows
  id | name        | plan
   1 | Ann Lee     | pro
   3 | Cara Diaz   | team
   5 | Eve Martin  | pro
   6 | Finn Larsen | team
   8 | Hana Sato   | team
  10 | Jade Wong   | pro
  12 | Lena Novak  | pro

# NOT IN on an enum field
plan NOT IN ('free')
=> 7 rows
  id | name        | plan
   1 | Ann Lee     | pro
   3 | Cara Diaz   | team
   5 | Eve Martin  | pro
   6 | Finn Larsen | team
   8 | Hana Sato   | team
  10 | Jade Wong   | pro
  12 | Lena Novak  | pro

# IN on a joined field
country IN ('France', 'Japan')
=> 5 rows
  id | name       | country
   1 | Ann Lee    | France
   2 | Bob Stone  | Japan
   5 | Eve Martin | France
   8 | Hana Sato  | Japan
  10 | Jade Wong  | Japan

# NOT IN keeps rows where the field is NULL
country NOT IN ('France', 'Germany')
=> 7 rows
  id | name       | country
   2 | Bob Stone  | Japan
   3 | Cara Diaz  | Brazil
   7 | Gil Moreau | NULL
   8 | Hana Sato  | Japan
  10 | Jade Wong  | Japan
  12 | Lena Novak | Brazil
  13 | Mo Reyes   | NULL

# ... unless the list holds NULL
country NOT IN ('France', NULL)
=> 9 rows
  id | name        | country
   2 | Bob Stone   | Japan
   3 | Cara Diaz   | Brazil
   4 | Dan O'Brien | Germany
   6 | Finn Larsen | Germany
   8 | Hana Sato   | Japan
   9 | Ivan Petrov | Germany
  10 | Jade Wong   | Japan
  11 | Kai Becker  | Germany
  12 | Lena Novak  | Brazil

# A NULL item in IN matches NULL rows
country IN ('Brazil', NULL)
=> 4 rows
  id | name       | country
   3 | Cara Diaz  | Brazil
   7 | Gil Moreau | NULL
  12 | Lena Novak | Brazil
  13 | Mo Reyes   | NULL

# IN on an integer field, quoted and unquoted numbers mixed
age IN (17, '30', 99)
=> 2 rows
  id | name        | age
   9 | Ivan Petrov |  17
  10 | Jade Wong   |  30

# NOT IN on a float field keeps NULL heights
height NOT IN (1.6, 1.8)
