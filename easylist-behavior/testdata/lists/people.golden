==== SDL generated by easylist-gqlgen ========================================

type PeopleRow {
  id: Int64!
  uid: UUID!
  name: String!
  nickname: String
  age: Int64
  height: Float
  balance: Decimal
  active: Boolean
  plan: PeoplePlan!
  due: Date
  last_seen: Time
  created_at: Time!
  country: String
  country_code: String
  order_count: Int64!
  last_order_at: Time
  tags: [String!]
  lucky_numbers: [Int64!]
  ratings: [Float!]
  prices: [Decimal!]
  answers: [Boolean!]
  holidays: [Date!]
  logins: [Time!]
  friend_ids: [UUID!]
  roles: [PeopleRoles!]!
  display: String!
  age_group: String
  tier: PeopleTier!
  labels: [String!]!
}

type PeoplePage {
  items: [PeopleRow!]!
  totalCount: Int!
}

enum PeoplePlan {
  FREE
  PRO
  TEAM
}

enum PeopleRoles {
  ADMIN
  EDITOR
  VIEWER
}

enum PeopleTier {
  NEW
  REGULAR
  LOYAL
}

enum PeopleSortField {
  ID
  UID
  NAME
  NICKNAME
  AGE
  HEIGHT
  BALANCE
  ACTIVE
  PLAN
  DUE
  LAST_SEEN
  CREATED_AT
  COUNTRY
  COUNTRY_CODE
  ORDER_COUNT
  LAST_ORDER_AT
}

input PeopleSort {
  field: PeopleSortField!
  direction: SortDirection! = ASC
}

input PeopleListInput {
  filter: String
  sort: [PeopleSort!]
  limit: Int
  offset: Int
  """
  The client's UTC offset in minutes, positive east of UTC (UTC+02:00 is 120),
  between -720 and 840. Relative time values such as TODAY are evaluated in
  this zone. When omitted, the server's local time zone is used.
  """
  timezone: Int
}

enum PeopleExportField {
  ID
  UID
  NAME
  NICKNAME
  AGE
  HEIGHT
  BALANCE
  ACTIVE
  PLAN
  DUE
  LAST_SEEN
  CREATED_AT
  COUNTRY
  COUNTRY_CODE
  ORDER_COUNT
  LAST_ORDER_AT
  TAGS
  LUCKY_NUMBERS
  RATINGS
  PRICES
  ANSWERS
  HOLIDAYS
  LOGINS
  FRIEND_IDS
  ROLES
  DISPLAY
  AGE_GROUP
  TIER
  LABELS
}

input PeopleExportInput {
  fields: [PeopleExportField!]!
  filter: String
  sort: [PeopleSort!]
  format: ExportFormat!
  """
  The client's UTC offset in minutes, positive east of UTC (UTC+02:00 is 120),
  between -720 and 840. Relative time values such as TODAY are evaluated in
  this zone. When omitted, the server's local time zone is used.
  """
  timezone: Int
  """
  The moment at which relative time values such as TODAY are evaluated. When
  omitted, the server's current time is used.
  """
  asOf: Time
}

==== Operator matrix =========================================================

For every field, each operator is probed with the filter
"<field>" <operator> <sample>, where BETWEEN, IN, and NOT IN take the list
(<sample>, <sample>) and the NULL rows use NULL as the value. The probe is
planned with CompiledList.Plan at the reference time and lowered with
sqlpg.Lower, which every driver uses to validate a plan. A row shows ok, or
the parse, plan, or lowering error. An array field uses its element type's
sample. Samples by type:
  text       'x'
  integer    1
  float      1.5
  numeric    1.5
  boolean    TRUE
  date       '2026-10-27'
  timestamp  '2026-10-27T10:00:00Z'
  uuid       '00000000-0000-4000-8000-000000000001'
  enum       the field's first declared value, quoted

