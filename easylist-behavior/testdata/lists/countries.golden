==== SDL generated by easylist-gqlgen ========================================

type CountriesRow {
  id: Int64!
  name: String!
  code: String!
}

type CountriesPage {
  items: [CountriesRow!]!
  totalCount: Int!
}

enum CountriesSortField {
  ID
  NAME
  CODE
}

input CountriesSort {
  field: CountriesSortField!
  direction: SortDirection! = ASC
}

input CountriesListInput {
  filter: String
  sort: [CountriesSort!]
  limit: Int
  offset: Int
  """
  The client's UTC offset in minutes, positive east of UTC (UTC+02:00 is 120),
  between -720 and 840. Relative time values such as TODAY are evaluated in
  this zone. When omitted, the server's local time zone is used.
  """
  timezone: Int
}

enum CountriesExportField {
  ID
  NAME
  CODE
}

input CountriesExportInput {
  fields: [CountriesExportField!]!
  filter: String
  sort: [CountriesSort!]
  format: ExportFormat!
  """
  The client's UTC offset in minutes, positive east of UTC (UTC+02:00 is 120),
  between -720 and 840. Relative time values such as TODAY are evaluated in
  this zone. When omitted, the server's local time zone is used.
  """
  timezone: Int
  """
  The moment at which relative time values such as TODAY are evaluated. When
  omitted, the server's current time is used.
  """
  asOf: Time
}

==== Operator matrix =========================================================

For every field, each operator is probed with the filter
"<field>" <operator> <sample>, where BETWEEN, IN, and NOT IN take the list
(<sample>, <sample>) and the NULL rows use NULL as the value. The probe is
planned with CompiledList.Plan at the reference time and lowered with
sqlpg.Lower, which every driver uses to validate a plan. A row shows ok, or
the parse, plan, or lowering error. An array field uses its element type's
sample. Samples by type:
  text       'x'
  integer    1
  float      1.5
  numeric    1.5
  boolean    TRUE
  date       '2026-10-27'
  timestamp  '2026-10-27T10:00:00Z'
  uuid       '00000000-0000-4000-8000-000000000001'
  enum       the field's first declared value, quoted

id (integer)
  =         ok
  !=        ok
  >         ok
  >=        ok
  <         ok
  <=        ok
  CONTAINS  error: unsupported operator "CONTAINS" for field "id" at position 6
  EXCLUDES  error: unsupported operator "EXCLUDES" for field "id" at position 6
  BETWEEN   ok
  IN        ok
  NOT IN    ok
  = NULL    ok
  != NULL   ok

name (text)
  =         ok
  !=        ok
  >         error: unsupported operator ">" for field "name" at position 8
  >=        error: unsupported operator ">=" for field "name" at position 8
  <         error: unsupported operator "<" for field "name" at position 8
  <=        error: unsupported operator "<=" for field "name" at position 8
  CONTAINS  ok
  EXCLUDES  ok
  BETWEEN   error: unsupported operator "BETWEEN" for field "name" at position 8
  IN        ok
  NOT IN    ok
  = NULL    ok
  != NULL   ok

code (text)
  =         ok
  !=        ok
  >         error: unsupported operator ">" for field "code" at position 8
  >=        error: unsupported operator ">=" for field "code" at position 8
  <         error: unsupported operator "<" for field "code" at position 8
  <=        error: unsupported operator "<=" for field "code" at position 8
  CONTAINS  ok
  EXCLUDES  ok
  BETWEEN   error: unsupported operator "BETWEEN" for field "code" at position 8
  IN        ok
  NOT IN    ok
  = NULL    ok
  != NULL   ok
